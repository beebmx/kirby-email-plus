{
    "name": "beebmx/kirby-email-plus",
    "description": "Email+ extends Kirby's email capabilities by adding support for multiple email services using the same Kirby email API.",
    "license": "MIT",
    "type": "kirby-plugin",
    "version": "2.0.0",
    "homepage": "https://github.com/beebmx/kirby-email-plus",
    "keywords": [
        "email",
        "mail",
        "kirby",
        "resend",
        "mailgun",
        "kirby-plugin",
        "kirby5",
        "kirby6"
    ],
    "authors": [
        {
            "name": "Fernando Gutierrez",
            "homepage": "https://beeb.mx"
        }
    ],
    "require": {
        "php": "^8.4",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0 || ^6.0",
        "laravel/pint": "^1.32",
        "mailgun/mailgun-php": "^4.5",
        "nyholm/psr7": "^1.8.2",
        "pestphp/pest": "^5.3",
        "resend/resend-php": "^1.19",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beebmx\\KirbEmailPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "suggest": {
        "resend/resend-php": "Required to enable support for the Resend mail.",
        "symfony/http-client": "Required to enable support for the Mailgun mail.",
        "mailgun/mailgun-php": "Required to enable support for the Mailgun mail.",
        "nyholm/psr7": "Required to enable support for the Mailgun mail."
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "kirby": {
            "compatible": "^5.0 || ^6.0"
        },
        "kirby-cms-path": false,
        "kirby-plugin-path": "tests/Fixtures/site/plugins"
    }
}
